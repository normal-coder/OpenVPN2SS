# ==============================================================================
# OpenVPN2SS 环境变量配置 (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 基础连接与实例标识 (必填/常用)
# ------------------------------------------------------------------------------
# Shadowsocks 客户端连接密码（必填，请务必修改为强密码）
SS_PASSWORD=your_secure_password_here

# 宿主机映射端口（容器内固定监听 5162，多实例部署时请为每个实例分配不同端口）
SS_PORT=5162

# 容器名称（建议按业务环境命名，如 openvpn-dev、openvpn-prod，避免命名冲突）
CONTAINER_NAME=openvpn-client

# Docker Compose 项目/分组名称（可选）
# 默认采用当前目录名。若希望在 OrbStack / Docker Desktop 中将多个实例聚合在同一个卡片分组下，可手动指定相同名称
# COMPOSE_PROJECT_NAME=openvpn

# Docker 镜像名称与版本标签（可选）
# 默认已锁定稳定版 normalcoder/openvpn2ss:v2.0.0。若需尝鲜最新版或使用自建镜像可取消注释覆盖
# IMAGE_NAME=normalcoder/openvpn2ss:latest

# Shadowsocks 加密方式（默认 aes-256-gcm）
SS_METHOD=aes-256-gcm

# ------------------------------------------------------------------------------
# 2. OpenVPN 身份凭据 (可选，免密文文件)
# ------------------------------------------------------------------------------
# 若你的 OpenVPN 服务端启用了账号密码认证（AUTH_USER_PASS），可直接在此填写
# 容器启动时会自动注入，无需在 config/openvpn/ 目录下创建 pass.txt 密码文件
# VPN_USERNAME=your_vpn_username
# VPN_PASSWORD=your_vpn_password

# ------------------------------------------------------------------------------
# 3. DNS 与网络解析高级选项 (选配)
# ------------------------------------------------------------------------------
# 是否启用内置 dnsmasq 解析器（默认 true，负责动态汇聚内网 DNS 与公共保底解析）
ENABLE_DNSMASQ=true

# 显式指定上游内网 DNS 服务器（逗号分隔，可选）
# 【机制与使用场景】：
#   - 职责定位：它是容器内置 dnsmasq 的「上游查询来源」（通常为目标内部的 CoreDNS/域控 IP）；
#   - 默认行为：通常无需配置（留空即可），OpenVPN 建立连接后会自动捕获服务端下发推送的内网 DNS；
#   - 适用场景：仅当目标服务端未配置 DHCP 下发、或推送的 DNS 异常时在此手动指定（例如 10.8.0.1）；
#   - 与 config/dnsmasq.d/ 的区别：若只是对个别私有域名做「静态绑定/泛解析劫持」，请编辑 config/dnsmasq.d/custom.conf，无需配置此项。
# DNS_SERVERS=10.8.0.1

# 公共保底 DNS 服务器（逗号分隔，可选）
# 当内网 DNS 解析失败、超时或目标内网未配置公网递归解析时，自动通过保底 DNS 解析公共外网域名
DNS_FALLBACK=223.5.5.5,114.114.114.114

# 等待 OpenVPN 隧道网卡 (tun0) 与路由就绪的最大超时秒数（默认 60）
VPN_READY_TIMEOUT=60

# ------------------------------------------------------------------------------
# 4. 目录路径自定义 (可选，留空使用当前工程相对路径)
# ------------------------------------------------------------------------------
# OVPN_CONFIG_DIR=./config/openvpn
# DNS_CONFIG_DIR=./config/dnsmasq.d
# LOG_DIR=./logs
