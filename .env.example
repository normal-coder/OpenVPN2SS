# Shadowsocks Password (overrides password in shadowsocks.json if specified)
SS_PASSWORD=your_password_here

# Host port mapping (container port is 5162)
SS_PORT=5162

# Container name for multi-instance deployments
CONTAINER_NAME=openvpn-client

# Timeout in seconds to wait for OpenVPN tunnel and routes to be ready
VPN_READY_TIMEOUT=60
